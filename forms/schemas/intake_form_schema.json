{
  "_comment": "The structured Deal Intake Form the realtor fills in once. Groups map to UI sections. Each field lists which form(s)/field_id(s) it feeds — 'profile' means it's also in deal_profile_schema.json (shared across forms), 'form_specific' means it only appears on one form. Radio/checkbox 'options' give the value code to write for the fill pipeline (reverse-engineered from real filled PDFs, order = order of appearance in the form, not guaranteed Yes-first).",

  "groups": [
    {
      "group": "parties",
      "label": "Parties",
      "fields": [
        { "key": "tenant1_first_name", "label": "Tenant 1 — First Name", "type": "text", "hidden": true, "derived_from": "tenant1_full_name", "profile": "tenant1_full_name", "targets": { "2229e": ["txtbuyer1FName"] } },
        { "key": "tenant1_last_name", "label": "Tenant 1 — Last Name", "type": "text", "hidden": true, "derived_from": "tenant1_full_name", "profile": "tenant1_full_name", "targets": { "2229e": ["txtbuyer1LName"] } },
        { "key": "tenant1_full_name", "label": "Tenant 1 — Full Name", "type": "text", "profile": "tenant1_full_name", "targets": { "2229e": ["txtbuyersig1"], "form_400": ["txtbuyer1"], "form_410": ["txtbuyer1", "txtbuyersig1"], "form_324": ["txtbuyer1", "txtbuyersig1"], "form_372": ["txtbuyer1", "txtbuyersig1"] } },
        { "key": "tenant2_first_name", "label": "Tenant 2 — First Name (optional)", "type": "text", "hidden": true, "derived_from": "tenant2_full_name", "profile": "tenant2_full_name", "targets": { "2229e": ["txtbuyer2FName"] } },
        { "key": "tenant2_last_name", "label": "Tenant 2 — Last Name (optional)", "type": "text", "hidden": true, "derived_from": "tenant2_full_name", "profile": "tenant2_full_name", "targets": { "2229e": ["txtbuyer2LName"] } },
        { "key": "tenant2_full_name", "label": "Tenant 2 — Full Name (optional)", "type": "text", "profile": "tenant2_full_name", "targets": { "2229e": ["txtbuyersig2"], "form_400": ["txtbuyer2"], "form_410": ["txtbuyer2", "txtbuyersig2"], "form_324": ["txtbuyer2", "txtbuyersig2"], "form_372": ["txtbuyer2", "txtbuyersig2"] } },
        { "key": "landlord_full_name", "label": "Landlord — Full Legal Name", "type": "text", "profile": "landlord_full_name", "targets": { "2229e": ["txtseller1", "txtRentPayable", "txtsellersig1"], "form_400": ["txtseller1", "txtsellersig1"], "form_324": ["txtseller1", "txtsellersig1"] } },
        { "key": "guarantor_name", "label": "Guarantor Name (optional)", "type": "text", "form_specific": "form_400", "targets": { "form_400": ["txtguarsig"] } },
