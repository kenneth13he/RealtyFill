        { "key": "property_street_name", "label": "Street Name", "type": "text", "profile": "property_street_name", "targets": { "2229e": ["txtp_street"], "form_400": ["txtp_street"], "form_410": ["txtp_street"], "form_324": ["txtp_street"] } },
        { "key": "property_unit_number", "label": "Unit Number", "type": "text", "profile": "property_unit_number", "targets": { "2229e": ["txtp_unitNumber"], "form_400": ["txtp_UnitNumber"], "form_410": ["txtp_UnitNumber"], "form_324": ["txtp_UnitNumber"] } },
        { "key": "property_city", "label": "City / Municipality", "type": "text", "profile": "property_city", "targets": { "2229e": ["txtp_city"], "form_400": ["txtp_city"], "form_410": ["txtp_city"], "form_324": ["txtp_city"] } },
        { "key": "property_province", "label": "Province", "type": "text", "default": "Ontario", "profile": "property_province", "targets": { "form_400": ["txtp_state"], "form_324": ["txtp_state"] } },
        { "key": "property_postal_code", "label": "Postal Code", "type": "text", "profile": "property_postal_code", "targets": { "2229e": ["txtp_zipcode"], "form_400": ["txtp_zipcode"], "form_410": ["txtp_zipcode"], "form_324": ["txtp_zipcode"] } },
        { "key": "property_is_condo", "label": "Is this unit in a condominium?", "type": "radio", "options": [ { "value": "/1", "label": "Yes" }, { "value": "/2", "label": "No" } ], "profile": "property_is_condo", "targets": { "2229e": ["chkOpt_Condo"] } },
