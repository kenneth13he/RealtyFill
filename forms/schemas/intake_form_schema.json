        { "key": "rent_deposit_amount", "label": "Rent Deposit Amount ($)", "type": "currency", "condition": "rent_deposit_required == '/2'", "targets": { "2229e": ["txtrentDeposit"] } },
        { "key": "key_deposit_required", "label": "Is a key deposit required?", "type": "radio", "options": [ { "value": "/1", "label": "No key deposit required" }, { "value": "/2", "label": "Key deposit required (enter amount + details below)" } ], "targets": { "2229e": ["chkOpt_KeyDeposit"] } },
        { "key": "key_deposit_amount", "label": "Key Deposit Amount ($)", "type": "currency", "condition": "key_deposit_required == '/2'", "targets": { "2229e": ["txtKeyDeposit"] } },
