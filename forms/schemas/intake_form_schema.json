        { "key": "guest_parking", "label": "Guest Parking", "type": "radio", "options": [ { "value": "/1", "label": "Yes, included" }, { "value": "/2", "label": "No" }, { "value": "/3", "label": "No charge" }, { "value": "/4", "label": "Pay per use" } ], "targets": { "2229e": ["chkOpt_GuestPark"] } },
