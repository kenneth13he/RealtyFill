{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "bindings": [
        {
          "type": "service",
          "service": "pdf-service",
          "format": "url",
          "env": "PDF_SERVICE_URL"
        }
      ]
    },
    "pdf-service": {
      "root": "pdf-service/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "frontend" } }]
}
