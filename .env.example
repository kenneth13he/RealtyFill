# Copy to .env.local (gitignored) and fill in real values. Never commit real
# secrets — .env.local is excluded via .gitignore, .env.example is the only
# env file meant to be committed.

# Used by lib/claude.ts for the listing-extraction feature (app/api/extract-listing).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase project — Settings > API in the Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security: server-only, never
# expose it to the browser (see lib/supabase/admin.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the Next.js app and pdf-service (pdf-service/main.py).
# Set the SAME value on both services and /fill stops accepting requests from
# anyone else; leave it unset and both sides behave as they did before, with
# pdf-service logging a warning at startup. Generate one with:
#   openssl rand -base64 32
PDF_SERVICE_SECRET=

# Base URL used to build the email-confirmation callback link Supabase sends
# on signup (app/login/actions.ts, app/auth/callback/route.ts). Update to the
# real deployed URL once the app has one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
